---
import Base from "../../layouts/Base.astro";
import { allCards, price, heading, type Card } from "../../lib/cards";

export function getStaticPaths() {
  return allCards.map((card) => ({ params: { slug: card.slug }, props: { card } }));
}

const { card } = Astro.props as { card: Card };
const name = heading(card);
const description = `${name}${card.team ? ` (${card.team})` : ""}. Raw, ${card.condition.toLowerCase()} condition. ${price(card.price_cents)} with combined shipping.`;

// Product structured data so search results can show the price and stock.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  image: [new URL(card.front, Astro.site).href, ...(card.back ? [new URL(card.back, Astro.site).href] : [])],
  description,
  sku: `CSU-${card.id}`,
  offers: {
    "@type": "Offer",
    price: (card.price_cents / 100).toFixed(2),
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/UsedCondition",
    url: new URL(`/cards/${card.slug}/`, Astro.site).href,
  },
};
---
<Base title={`${name} | CSU Sports Cards`} description={description} image={card.front}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <p class="crumb"><a href="/">All cards</a> · {card.sport}</p>
  <div class="card">
    <div class="photos">
      <a href={card.front} data-zoom><img src={card.front} alt={`${name} front`} width="800" height="1110" /></a>
      {card.back && <a href={card.back} data-zoom><img src={card.back} alt={`${name} back`} width="800" height="1110" loading="lazy" /></a>}
    </div>
    <div class="info">
      <h1>{card.player} #{card.number}</h1>
      <p class="set">{card.year} {card.set}</p>
      <p class="price">{price(card.price_cents)}</p>
      <dl>
        <dt>Condition</dt><dd>{card.condition}</dd>
        {card.team && <><dt>Team</dt><dd>{card.team}</dd></>}
        <dt>Sport</dt><dd>{card.sport}</dd>
        <dt>Type</dt><dd>Raw (ungraded)</dd>
        <dt>Item #</dt><dd>CSU-{card.id}</dd>
      </dl>
      <button class="buy" disabled>Checkout coming soon</button>
      <p class="note">The scans are the exact card you'll receive. $1.25 shipping per order, plus $0.50 for each additional card.</p>
    </div>
  </div>

  <dialog id="zoom" aria-label="Card photo">
    <button class="close" aria-label="Close">×</button>
    <div class="frame"><img alt="" /></div>
    <div class="sides">
      <button type="button" data-side="0">Front</button>
      {card.back && <button type="button" data-side="1">Back</button>}
      <span class="hint">Click photo to zoom</span>
    </div>
  </dialog>
</Base>

<script>
  // Photo viewer: opens on the same page instead of navigating to the image.
  // The links keep their href so the photo still opens if JavaScript is off.
  // Click the photo to zoom in at that spot; move the mouse (or drag on a
  // phone) to look around; click again to zoom out. Detail is capped by the
  // scan resolution (~817px wide at the 2026-10 NAPS2 settings).
  const dialog = document.getElementById("zoom") as HTMLDialogElement;
  const frame = dialog.querySelector(".frame") as HTMLDivElement;
  const big = frame.querySelector("img") as HTMLImageElement;
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-zoom]")];
  const sideButtons = [...dialog.querySelectorAll<HTMLButtonElement>("[data-side]")];
  let current = 0;
  let zoomed = false;

  const setZoom = (on: boolean) => {
    zoomed = on;
    big.classList.toggle("zoomed", on);
    if (!on) big.style.transformOrigin = "center";
  };

  const focusPoint = (e: PointerEvent | MouseEvent) => {
    const r = big.getBoundingClientRect();
    // getBoundingClientRect is the scaled box while zoomed; dividing by its
    // own size keeps the percentages right either way.
    const x = ((e.clientX - r.left) / r.width) * 100;
    const y = ((e.clientY - r.top) / r.height) * 100;
    big.style.transformOrigin = `${Math.min(100, Math.max(0, x))}% ${Math.min(100, Math.max(0, y))}%`;
  };

  const show = (i: number) => {
    current = (i + links.length) % links.length;
    setZoom(false);
    big.src = links[current].href;
    big.alt = links[current].querySelector("img")?.alt ?? "";
    sideButtons.forEach((b) => b.classList.toggle("on", Number(b.dataset.side) === current));
  };

  links.forEach((a, i) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  sideButtons.forEach((b) => b.addEventListener("click", () => show(Number(b.dataset.side))));
  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => setZoom(false));
  // A click on the backdrop (outside the photo) closes it.
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") show(current + 1);
    if (e.key === "ArrowLeft") show(current - 1);
  });

  big.addEventListener("click", (e) => {
    if (!zoomed) focusPoint(e);
    setZoom(!zoomed);
  });
  // Mouse: follows the pointer. Touch: follows a drag.
  big.addEventListener("pointermove", (e) => {
    if (zoomed && (e.pointerType === "mouse" || e.buttons)) focusPoint(e);
  });
</script>

<style>
  .crumb { color: var(--muted); font-size: .9rem; margin: 0 0 16px; }
  .card { display: grid; gap: 32px; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 760px) { .card { grid-template-columns: 1fr; } }
  .photos { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  .photos img { width: 100%; height: auto; border-radius: 6px; background: var(--surface); }
  h1 { margin: 0; font-size: 1.6rem; }
  .set { color: var(--muted); margin: 4px 0 12px; }
  .price { font-size: 1.8rem; font-weight: 700; margin: 0 0 16px; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0 0 20px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .buy { width: 100%; padding: 12px; font-size: 1rem; border: 0; border-radius: 6px;
         background: var(--accent); color: var(--accent-text); opacity: .5; cursor: not-allowed; }
  .note { color: var(--muted); font-size: .85rem; margin-top: 12px; }
  .photos a { cursor: zoom-in; }
  dialog { padding: 0; border: 0; background: transparent; max-width: 96vw; max-height: 96vh; overflow: visible; }
  dialog::backdrop { background: rgba(0, 0, 0, .85); }
  .frame { overflow: hidden; border-radius: 6px; }
  dialog img { display: block; max-width: 96vw; max-height: 86vh; width: auto; height: auto;
               cursor: zoom-in; transition: transform .15s ease-out; touch-action: none; }
  dialog img.zoomed { transform: scale(2.5); cursor: zoom-out; }  /* zoom level */
  .sides { display: flex; gap: 8px; align-items: center; justify-content: center; margin-top: 10px; }
  .sides button { padding: 6px 16px; border: 1px solid #888; border-radius: 999px; background: transparent;
                  color: #eee; font-size: .9rem; cursor: pointer; }
  .sides button.on { background: #fff; color: #111; border-color: #fff; }
  .hint { color: #aaa; font-size: .8rem; margin-left: 8px; }
  .close { position: absolute; top: -14px; right: -14px; width: 36px; height: 36px; border-radius: 50%;
           border: 0; padding: 0; background: #fff; color: #111; font-size: 1.4rem; line-height: 1; cursor: pointer; z-index: 1; }
</style>
