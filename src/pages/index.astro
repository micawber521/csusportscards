---
const title = "CSU Sports Cards";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Raw sports cards — baseball, basketball, football. Combined shipping." />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center;
             font-family: system-ui, sans-serif; background: #111; color: #eee; text-align: center; padding: 16px; }
      h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 .5rem; }
      p { color: #aaa; margin: 0; }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Coming soon.</p>
    </main>
  </body>
</html>
