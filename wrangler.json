{
  "name": "csusportscards",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "csusportscards.com",
      "custom_domain": true
    },
    {
      "pattern": "www.csusportscards.com",
      "custom_domain": true
    }
  ]
}
